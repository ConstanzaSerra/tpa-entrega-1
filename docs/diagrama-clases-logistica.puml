@startuml DonaTrack - Diagrama de Clases - Logistica (Entrega 4)

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBackgroundColor #EEEDFE
skinparam classBorderColor #7F77DD
skinparam classArrowColor #534AB7
skinparam stereotypeCBackgroundColor #E1F5EE
skinparam stereotypeABackgroundColor #FAEEDA
skinparam noteBackgroundColor #FAEEDA
skinparam noteBorderColor #BA7517

' ─────────────────────────────────────────
'  CAMIONES
' ─────────────────────────────────────────

class Camion {
  - Long id
  - String patente
  - double volumenM3
  - double alturaM
  - double capacidadKg
  + getPatente(): String
  + getCapacidadKg(): double
}

class PosicionCamion {
  - Long id
  - Long camionId
  - double latitud
  - double longitud
  - Double velocidad
  - Instant timestamp
}

' ─────────────────────────────────────────
'  RUTAS
' ─────────────────────────────────────────

class Ruta {
  - Long id
  - Camion camion
  - List<ParadaDeRuta> paradas
  - EstadoRuta estado
  - String linkMapa
  + iniciar(): void
  + completar(): void
  + agregarParada(ParadaDeRuta): void
  + getEstado(): EstadoRuta
}

enum EstadoRuta {
  PLANIFICADA
  EN_CURSO
  COMPLETADA
}

class ParadaDeRuta {
  - Long id
  - Long entidadBeneficiariaId
  - String direccion
  - List<Entrega> entregas
  + agregarEntrega(Entrega): void
}

' ─────────────────────────────────────────
'  ENTREGAS
' ─────────────────────────────────────────

class Entrega {
  - Long id
  - Long donacionId
  - Long entidadBeneficiariaId
  - String direccionDestino
  - EstadoEntrega estado
  - Camion camionQueEntrego
  - LocalDateTime fechaHoraEntrega
  - List<String> fotosUrl
  + iniciarTraslado(): void
  + confirmar(Camion, LocalDateTime): void
  + rechazar(): void
  + retornarADeposito(): void
  + agregarFoto(String): void
  + getEstado(): EstadoEntrega
}

enum EstadoEntrega {
  PENDIENTE
  EN_TRASLADO
  ENTREGADA
  NO_RECIBIDA
}

' ─────────────────────────────────────────
'  PLANIFICACION E INTEGRACION GRAPHQL (Entrega 4)
' ─────────────────────────────────────────

interface DonacionesAPI <<puerto>> {
  + obtenerDonacionesAsignadas(): List<DonacionAsignadaDTO>
  + notificarInicioRuta(EventoInicioRutaDTO): void
  + notificarEntregaConfirmada(EventoEntregaConfirmadaDTO): void
  + notificarEntregaFallida(EventoEntregaFallidaDTO): void
}

class DonacionesGraphQLAdapter <<adaptador>> {
  - String graphqlEndpoint
  + obtenerDonacionesAsignadas(): List<DonacionAsignadaDTO>
  + notificarInicioRuta(EventoInicioRutaDTO): void
  + notificarEntregaConfirmada(EventoEntregaConfirmadaDTO): void
  + notificarEntregaFallida(EventoEntregaFallidaDTO): void
}

class LogisticaGraphQLController <<graphql>> {
  - GraphQL graphQL
  + ejecutar(Context): void
}

class PlanificadorRutas {
  - Set<Long> donacionesEnPlanificacion
  - String callbackUrl
  + planificar(): void
  + registrarResultado(PlanificacionCallbackDTO): void
}

class PlanificacionScheduler {
  + iniciar(delay, period, unit): void
  + iniciarDiario(LocalTime): void
  + detener(): void
}

' ─────────────────────────────────────────
'  RELACIONES
' ─────────────────────────────────────────

Ruta --> Camion
Ruta --> EstadoRuta
Ruta "1" *-- "0..*" ParadaDeRuta

ParadaDeRuta "1" o-- "0..*" Entrega

Entrega --> EstadoEntrega
Entrega --> "0..1" Camion : camionQueEntrego

PosicionCamion --> Camion : camionId

DonacionesAPI <|.. DonacionesGraphQLAdapter
PlanificadorRutas --> DonacionesAPI
LogisticaGraphQLController --> Camion
LogisticaGraphQLController --> Entrega
LogisticaGraphQLController --> Ruta
LogisticaGraphQLController --> PosicionCamion
LogisticaGraphQLController --> DonacionesAPI

PlanificacionScheduler --> PlanificadorRutas
PlanificadorRutas ..> Ruta : <<genera>>
PlanificadorRutas ..> Entrega : <<genera>>

@enduml
