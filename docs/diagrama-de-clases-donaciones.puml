@startuml DonaTrack - Diagrama de Clases (Donaciones - Entrega 4)

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBackgroundColor #EEEDFE
skinparam classBorderColor #7F77DD
skinparam classArrowColor #534AB7
skinparam stereotypeCBackgroundColor #E1F5EE
skinparam stereotypeABackgroundColor #FAEEDA
skinparam noteBackgroundColor #FAEEDA
skinparam noteBorderColor #BA7517

' ─────────────────────────────────────────
'  USUARIOS Y AUTENTICACIÓN WEB (Entrega 4)
' ─────────────────────────────────────────

class Usuario {
  - Long id
  - String email
  - String passwordHash
  - String nombreMostrar
  - RolUsuario rol
  - PersonaDonante donante
  - EntidadBeneficiaria entidadBeneficiaria
  + verificarPassword(String): boolean
  + {static} hashear(String): String
}

enum RolUsuario {
  ADMIN
  DONANTE
  ENTIDAD
}

class SesionManager <<web>> {
  + iniciarSesion(Context, Usuario): void
  + cerrarSesion(Context): void
  + obtenerUsuarioAutenticado(Context): Optional<Usuario>
  + exigirRol(Context, RolUsuario...): Usuario
}

class WebPortalController <<mvc>> {
  + landing(Context): void
  + mapaEntregasPublico(Context): void
  + mostrarRegistro(Context): void
  + mostrarLogin(Context): void
  + donanteDonaciones(Context): void
  + donanteEntidades(Context): void
  + donanteSeguimiento(Context): void
  + entidadNecesidades(Context): void
  + entidadDonaciones(Context): void
  + confirmarRecepcionEntidad(Context): void
  + entidadNotificaciones(Context): void
  + entidadSeguimiento(Context): void
  + adminDeposito(Context): void
  + adminMatchmaking(Context): void
  + adminCamiones(Context): void
  + adminImportarCsv(Context): void
}

' ─────────────────────────────────────────
'  COMUNICACIÓN GRAPHQL ENTRE SERVICIOS (Entrega 4)
' ─────────────────────────────────────────

interface LogisticaPort <<puerto>> {
  + listarCamiones(): List<CamionVistaDTO>
  + crearCamion(String, double, double, double): CamionVistaDTO
  + eliminarCamion(Long): boolean
  + listarEntregas(): List<EntregaVistaDTO>
  + listarRutas(): List<RutaVistaDTO>
  + listarUltimasPosiciones(): List<PosicionCamionVistaDTO>
  + confirmarEntregaConFotos(Long, Long, List<String>): boolean
}

class LogisticaGraphQLAdapter <<adaptador>> {
  - String graphqlEndpoint
  + ejecutarGraphQL(String, Map): JsonNode
}

class DonacionesGraphQLController <<graphql>> {
  - GraphQL graphQL
  + ejecutar(Context): void
}

' ─────────────────────────────────────────
'  DONANTES
' ─────────────────────────────────────────

abstract class PersonaDonante {
  - Long id
  - List<MedioDeContacto> mediosDeContacto
  - MedioDeContacto predeterminado
  + agregarMedio(MedioDeContacto): void
  + setPredeterminado(MedioDeContacto): void
  + getMedioDeContactoPredeterminado(): MedioDeContacto
  + medioDePreferencia(): MedioDeContacto
}

class PersonaHumana {
  - String nombre
  - String apellido
  - Integer edad
  - Integer dni
  - String genero
  - String direccion
}

class PersonaJuridica {
  - String razonSocial
  - TipoJuridico tipo
  - String rubro
  - List<Representante> representantes
  + agregarRepresentante(Representante): void
}

class Representante {
  - String nombre
  - String apellido
  - Integer dni
  - String email
}

enum TipoJuridico {
  GUBERNAMENTAL
  ONG
  EMPRESA
  INSTITUCION
}

' ─────────────────────────────────────────
'  MEDIOS DE CONTACTO  (Strategy de envio)
' ─────────────────────────────────────────

abstract class MedioDeContacto {
  - String valor
  + getValor(): String
  + enviarMensaje(String): void
}

class Email {
  + enviarMensaje(String): void
}

class Telefono {
  + enviarMensaje(String): void
}

class WhatsApp {
  + enviarMensaje(String): void
}

class EmailSender <<infraestructura>> {
  + {static} enviar(destino: String, cuerpo: String): void
}

' ─────────────────────────────────────────
'  BIENES Y CATEGORIAS
' ─────────────────────────────────────────

class Subcategoria {
  - Long id
  - String nombre
  - Categoria categoria
  - boolean requiereEstado
  - boolean esPerecible
  + getNombre(): String
  + getCategoria(): Categoria
}

enum Categoria {
  MOBILIARIO
  ALIMENTOS
  VESTIMENTA
}

abstract class Bien {
  - Long id
  - String descripcion
  - Subcategoria subcategoria
  - int cantidad
  - String unidadMedida
}

class BienSimple
class BienConEstado {
  - boolean esNuevo
}
class BienPerecible {
  - LocalDate fechaVencimiento
}

' ─────────────────────────────────────────
'  CARGA Y DONACIONES  (trazabilidad de estados)
' ─────────────────────────────────────────

class CargaDeDonacion {
  - Long id
  - LocalDate fecha
  - PersonaDonante donante
  - List<Bien> bienes
  + segmentar(): List<Donacion>
}

class Donacion {
  - Long id
  - Subcategoria subcategoria
  - int cantidad
  - String unidadMedida
  - EstadoDonacion estado
  - LocalDate fechaRegistro
  - PersonaDonante donante
  - EntidadBeneficiaria entidadAsignada
  - String justificacionFallida
  - List<CambioDeEstado> historial
  + asignarEntidad(EntidadBeneficiaria): void
  + avanzarEstado(): void
  + avanzarHacia(EstadoDonacion): void
  + marcarEntregaFallida(String): void
  + marcarVencida(): void
  + getHistorial(): List<CambioDeEstado>
}

class CambioDeEstado {
  - EstadoDonacion estado
  - LocalDateTime fechaHora
}

enum EstadoDonacion {
  EN_DEPOSITO
  ASIGNACION_REALIZADA
  LISTA_PARA_ENTREGAR
  EN_TRASLADO
  ENTREGADA
  ENTREGA_FALLIDA
  VENCIDA
}

' ─────────────────────────────────────────
'  ENTIDADES BENEFICIARIAS Y NECESIDADES
' ─────────────────────────────────────────

class EntidadBeneficiaria {
  - Long id
  - String razonSocial
  - String direccion
  - String telefono
  - List<String> emailsRepresentantes
  - List<Necesidad> necesidades
  + agregarNecesidad(Necesidad): void
  + medioDePreferencia(): MedioDeContacto
}

abstract class Necesidad {
  - Long id
  - Subcategoria subcategoria
  - String descripcion
  + estaSatisfecha(): Boolean
  + registrarRecepcion(Integer): void
}

class NecesidadExtraordinaria {
  - Integer cantidadRequerida
  - Integer cantidadRecibida
}

class NecesidadRecurrente {
  - PeriodoConsumo periodoConsumo
}

class PeriodoConsumo <<embeddable>> {
  - Integer cantidadObjetivo
  - String descripcion
  - Integer cantidadRecibida
}

' ─────────────────────────────────────────
'  MATCHMAKING  (Strategy de algoritmos)
' ─────────────────────────────────────────

interface AlgoritmoDonacion {
  + calcularSugerencias(Donacion, List<EntidadBeneficiaria>, List<Donacion>): List<EntidadBeneficiaria>
}

class CompatibilidadSemantica
class PrioridadSubatendidos

class ProcesadorMatchmaking {
  + procesar(Donacion, List<EntidadBeneficiaria>, List<Donacion>): PropuestaMatchmaking
}

class PropuestaMatchmaking {
  - Long id
  - Donacion donacion
  - List<EntidadBeneficiaria> entidadesSugeridas
  - boolean esCoincidenciaExacta
}

' ─────────────────────────────────────────
'  NOTIFICACIONES  (Observer + Bandeja Web)
' ─────────────────────────────────────────

interface Notificable {
  + medioDePreferencia(): MedioDeContacto
}

class EventoDeNotificacion {
  - List<Notificable> destinatarios
  - String mensaje
}

interface ObservadorDeNotificaciones {
  + notificar(EventoDeNotificacion): void
}

class GestorDeNotificaciones {
  - List<ObservadorDeNotificaciones> observadores
  + suscribir(ObservadorDeNotificaciones): void
  + publicar(EventoDeNotificacion): void
}

class EnviadorPorMedioPreferido {
  + notificar(EventoDeNotificacion): void
}

class RegistradorNotificacionesWeb {
  + notificar(EventoDeNotificacion): void
}

class NotificacionWeb {
  - Long id
  - String mensaje
  - LocalDateTime fechaHora
  - boolean leida
  - String destinatarioContacto
  - Long entidadId
  - Long donanteId
  + marcarLeida(): void
}

' ─────────────────────────────────────────
'  RELACIONES
' ─────────────────────────────────────────

Usuario --> RolUsuario
Usuario --> "0..1" PersonaDonante
Usuario --> "0..1" EntidadBeneficiaria
SesionManager ..> Usuario : autentica por Cookie HTTP
WebPortalController --> SesionManager
WebPortalController --> LogisticaPort
LogisticaPort <|.. LogisticaGraphQLAdapter
DonacionesGraphQLController --> Donacion

PersonaDonante <|-- PersonaHumana
PersonaDonante <|-- PersonaJuridica
PersonaJuridica "1" *-- "1..*" Representante
PersonaJuridica --> TipoJuridico
PersonaDonante "1" o-- "1..*" MedioDeContacto
PersonaDonante ..|> Notificable

MedioDeContacto <|-- Email
MedioDeContacto <|-- Telefono
MedioDeContacto <|-- WhatsApp
Email ..> EmailSender : delega envio

Subcategoria --> Categoria
Bien <|-- BienSimple
Bien <|-- BienConEstado
Bien <|-- BienPerecible
Bien --> Subcategoria

CargaDeDonacion "1" *-- "1..*" Bien
CargaDeDonacion ..> Donacion : <<genera>>

Donacion --> Subcategoria
Donacion --> EstadoDonacion
Donacion --> PersonaDonante
Donacion --> EntidadBeneficiaria
Donacion "1" *-- "0..*" CambioDeEstado : historial
CambioDeEstado --> EstadoDonacion

EntidadBeneficiaria "1" *-- "0..*" Necesidad
EntidadBeneficiaria ..|> Notificable
Necesidad <|-- NecesidadExtraordinaria
Necesidad <|-- NecesidadRecurrente
NecesidadRecurrente *-- PeriodoConsumo
Necesidad --> Subcategoria

AlgoritmoDonacion <|.. CompatibilidadSemantica
AlgoritmoDonacion <|.. PrioridadSubatendidos
ProcesadorMatchmaking ..> AlgoritmoDonacion : usa
ProcesadorMatchmaking ..> PropuestaMatchmaking : produce
PropuestaMatchmaking --> Donacion
PropuestaMatchmaking --> EntidadBeneficiaria

ObservadorDeNotificaciones <|.. EnviadorPorMedioPreferido
ObservadorDeNotificaciones <|.. RegistradorNotificacionesWeb
RegistradorNotificacionesWeb ..> NotificacionWeb : persiste
GestorDeNotificaciones o-- "0..*" ObservadorDeNotificaciones
GestorDeNotificaciones ..> EventoDeNotificacion : publica
EventoDeNotificacion --> "0..*" Notificable : destinatarios
EnviadorPorMedioPreferido ..> MedioDeContacto : enviarMensaje

@enduml
