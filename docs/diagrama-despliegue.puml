@startuml DonaTrack_Despliegue

' Diagrama de despliegue - TPA4 DonaTrack (Presentación, GraphQL y Despliegue Cloud)
' Refleja:
' 1. Cliente Liviano MVC con motor de plantillas Handlebars y Cookies HTTP en Donaciones (:8080)
' 2. Reemplazo de HTTP/REST por GraphQL (POST /graphql) para la integración entre Donaciones y Logística
' 3. Persistencia relacional PostgreSQL independiente por microservicio (Database-per-Service)
' 4. Despliegue en contenedores Docker / PaaS Cloud (Render / Railway + Neon PostgreSQL)

skinparam backgroundColor #FFFFFF
skinparam node {
 BackgroundColor #EEEDFE
 BorderColor #7F77DD
 FontColor #000000
}
skinparam artifact {
 BackgroundColor #E1F5EE
 BorderColor #7F77DD
 FontColor #000000
}
skinparam database {
 BackgroundColor #FAEEDA
 BorderColor #BA7517
 FontColor #000000
}
skinparam note {
 BackgroundColor #FFF9E6
 BorderColor #BA7517
}

' --- Actores / dispositivos externos ---
node "Dispositivo de Usuario\n(Público / Donante / Entidad / Admin)" <<device>> {
 artifact "Web Browser\n(HTML5 + Leaflet Maps +\nCookie HTTP donatrack_session)" as browser
 artifact "donantes_10000.csv" as csv
}

node "Celular del Chofer" <<device>> {
 artifact "App móvil GPS\n(reporte de posición)" as appMovil
}

' --- Nube / Entorno Contenerizado (Render / Railway / Docker) ---
node "Cloud PaaS / Host Docker (Servicio Donaciones)" <<cloud>> {
 artifact "tpa-donaciones.jar\n(Java 17 + Javalin 6 + Handlebars MVC +\ngraphql-java + Hibernate JPA)\n:8080" as donaciones
}

node "Cloud PaaS / Host Docker (Servicio Logística)" <<cloud>> {
 artifact "tpa-logistica.jar\n(Java 17 + Javalin 6 +\ngraphql-java + Hibernate JPA)\n:8081" as logistica
}

node "Cluster PostgreSQL Cloud (Neon / Render DB)" <<cloud>> {
 database "PostgreSQL\ndonatrack_donaciones" as dbDonaciones
 database "PostgreSQL\ndonatrack_logistica" as dbLogistica
}

' --- Terceros ---
node "Proveedor externo" <<device>> {
 artifact "Planificador de Rutas\n:8082" as planificador
}

node "Servicios de notificación" <<device>> {
 artifact "SMTP Email / Twilio SMS & WhatsApp" as canales
}

' --- Conexiones ---
browser  --> donaciones  : HTTPS (GET/POST Vistas MVC Handlebars\n+ Cookie HTTP donatrack_session)
csv      --> donaciones  : HTTPS POST /admin/importar-csv\n(multipart/form-data >10.000 filas)
appMovil --> logistica   : HTTPS\n(POST /camiones/{id}/posicion)

logistica <--> donaciones : GraphQL sobre HTTP (POST /graphql)\n- Logística consulta donacionesAsignadas y muta eventos de ruta/entrega\n- Donaciones consulta flota, rutas, entregas y GPS y muta camiones/entregas

logistica --> planificador : HTTP async\n(lotes de ≤100)
planificador --> logistica : HTTP\n(POST /planificador/callback)

donaciones --> canales : envío externo de\nnotificaciones (Observer)

donaciones --> dbDonaciones : JDBC / TCP :5432
logistica  --> dbLogistica  : JDBC / TCP :5432

@enduml
