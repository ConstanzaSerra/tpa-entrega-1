{{#partial "contenido"}}
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card card-donatrack p-4 p-md-5 bg-white">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <h2 class="fw-bold mb-1"><i class="bi bi-filetype-csv text-primary me-2"></i>Importación Masiva de Donantes CSV</h2>
          <p class="text-muted mb-0">Migración histórica de personas donantes desde archivos CSV de más de 10.000 filas, otorgándoles automáticamente su usuario en la plataforma (Requerimiento 17).</p>
        </div>
        <span class="badge bg-primary px-3 py-2">{{totalDonantesActuales}} Donantes · {{totalUsuariosActuales}} Usuarios</span>
      </div>

      <style>
        /* Bootstrap pinta <code> en rosa/rojo y el formato esperado se lee como
           si fuera un error. Estos campos son informativos, no una falla. */
        .formato-csv code { color: #334155; font-weight: 500; }
      </style>

      <div class="bg-light border rounded-3 p-3 mb-4 small formato-csv">
        <div class="fw-bold mb-1"><i class="bi bi-table me-1"></i>Formato oficial esperado del archivo CSV:</div>
        <code>TipoPersona,TipoDoc,Documento,Nombre/Razón Social,Email,Teléfono</code><br>
        <code>HUMANA,DNI,12345678,Ana Pérez,ana@mail.com,+54 11 5555-5555</code><br>
        <code>JURIDICA,CUIT,30-12345678-9,Arcos Plateados S.A.,contacto@empresa.com,+54 11 4444-4444</code>
      </div>

      {{#if error}}
      <div class="alert alert-warning d-flex align-items-start" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>
        <div>
          <div class="fw-semibold">No se pudo importar el archivo</div>
          <div class="small">{{error}}</div>
        </div>
      </div>
      {{/if}}

      {{#if resultado}}
      <div class="border rounded-3 p-3 mb-4 {{#if resultado.tuvoErrores}}border-warning bg-warning-subtle{{else}}border-success bg-success-subtle{{/if}}">
        <div class="fw-bold mb-2">
          {{#if resultado.tuvoErrores}}
          <i class="bi bi-exclamation-circle-fill text-warning me-1"></i>Importación finalizada con observaciones
          {{else}}
          <i class="bi bi-check-circle-fill text-success me-1"></i>Importación finalizada correctamente
          {{/if}}
        </div>
        <div class="row text-center small g-2">
          <div class="col"><div class="fs-5 fw-bold">{{resultado.filasLeidas}}</div><div class="text-muted">filas leídas</div></div>
          <div class="col"><div class="fs-5 fw-bold">{{resultado.filasImportadas}}</div><div class="text-muted">importadas</div></div>
          <div class="col"><div class="fs-5 fw-bold">{{resultado.donantesCreados}}</div><div class="text-muted">nuevas</div></div>
          <div class="col"><div class="fs-5 fw-bold">{{resultado.donantesActualizados}}</div><div class="text-muted">actualizadas</div></div>
          <div class="col"><div class="fs-5 fw-bold">{{resultado.usuariosOtorgados}}</div><div class="text-muted">usuarios otorgados</div></div>
          <div class="col"><div class="fs-5 fw-bold">{{resultado.filasConError}}</div><div class="text-muted">con error</div></div>
        </div>
        <div class="text-muted small mt-2">Tiempo de proceso: {{resultado.milisegundos}} ms.</div>
      </div>
      {{/if}}

      {{#if errores}}
      <div class="mb-4">
        <div class="fw-semibold mb-2"><i class="bi bi-list-ul me-1"></i>Filas que no se pudieron importar</div>
        <p class="small text-muted">El resto del archivo se importó igual. Corregí estas filas en el CSV y volvé a subirlo: las personas ya importadas se actualizan, no se duplican.</p>
        <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
          <table class="table table-sm table-striped align-middle small mb-0">
            <thead class="table-light">
              <tr><th style="width: 5rem;">Línea</th><th>Fila</th><th>Motivo</th></tr>
            </thead>
            <tbody>
              {{#each errores}}
              <tr>
                <td class="fw-semibold">{{this.linea}}</td>
                <td>{{this.referencia}}</td>
                <td>{{this.motivo}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
      {{/if}}

      <!-- Opción 1: Subir un archivo CSV desde la computadora -->
      <form method="post" action="/admin/importar-csv" enctype="multipart/form-data" class="mb-4">
        <label class="form-label fw-semibold">Seleccionar archivo <span class="formato-csv"><code>.csv</code></span> desde tu equipo</label>
        <div class="input-group">
          <input type="file" name="archivoCsv" accept=".csv,text/csv" class="form-control" required>
          <button type="submit" class="btn btn-primary fw-semibold px-4">
            <i class="bi bi-cloud-arrow-up-fill me-1"></i>Importar y Otorgar Usuarios
          </button>
        </div>
      </form>

      <hr class="my-4">

      <!-- Opción 2: Descargar o ejecutar en 1 clic un lote de prueba de 10.500 filas -->
      <div class="d-flex flex-wrap justify-content-between align-items-center bg-light p-3 rounded-3">
        <div class="mb-2 mb-md-0">
          <h6 class="fw-bold mb-1"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Prueba de Estrés (+10.000 Filas)</h6>
          <p class="small text-muted mb-0">Podés descargar un archivo CSV de 10.500 filas o ejecutar su importación directa en lote.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/admin/importar-csv/ejemplo-10000.csv" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Descargar CSV (10.500 filas)
          </a>
          <form method="post" action="/admin/importar-csv">
            <input type="hidden" name="generarDemo10k" value="true">
            <button type="submit" class="btn btn-success btn-sm fw-semibold">
              <i class="bi bi-play-fill me-1"></i>Ejecutar Importación de 10.500 Filas Ahora
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{{/partial}}
{{> layout}}
