{{#partial "contenido"}}
<div class="encabezado-pagina mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-box-seam text-primary me-2"></i>Gestión de Depósito Central</h2>
    <p class="text-muted mb-0">Inventario de donaciones recibidas y control de vencimientos.</p>
  </div>
  <!-- Registrar es una tarea ocasional: vive en un panel y le deja la
       pantalla al inventario, que es lo que se mira todos los dias. -->
  <div class="d-flex gap-2 flex-wrap">
    <button class="btn btn-outline-primary btn-sm" data-bs-toggle="offcanvas" data-bs-target="#panelDonante">
      <i class="bi bi-person-plus me-1"></i>Nuevo donante
    </button>
    <button class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="offcanvas" data-bs-target="#panelDonacion">
      <i class="bi bi-box-arrow-in-down me-1"></i>Registrar donación
    </button>
    <a href="/admin/importar-csv" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-filetype-csv me-1"></i>Importar donantes
    </a>
  </div>
</div>

<!-- Resumen Ejecutivo del Depósito (KPIs / Métricas Clave) -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card card-donatrack p-3 bg-white border-0 shadow-sm h-100">
      <div class="d-flex align-items-center">
        <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3 text-primary">
          <i class="bi bi-box-seam fs-3"></i>
        </div>
        <div>
          <span class="text-muted small fw-semibold">Stock en Depósito</span>
          <h3 class="fw-bold mb-0 text-dark">{{numero resumen.enDeposito}}</h3>
          <small class="text-success"><i class="bi bi-check-circle me-1"></i>Disponibles para asignar</small>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card card-donatrack p-3 bg-white border-0 shadow-sm h-100">
      <div class="d-flex align-items-center">
        <div class="rounded-3 bg-info bg-opacity-10 p-3 me-3 text-info">
          <i class="bi bi-truck fs-3"></i>
        </div>
        <div>
          <span class="text-muted small fw-semibold">En Logística / En Camino</span>
          <h3 class="fw-bold mb-0 text-dark">{{numero resumen.enTransito}}</h3>
          <small class="text-muted"><i class="bi bi-arrow-right-circle me-1"></i>Asignadas o en viaje</small>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card card-donatrack p-3 bg-white border-0 shadow-sm h-100">
      <div class="d-flex align-items-center">
        <div class="rounded-3 bg-danger bg-opacity-10 p-3 me-3 text-danger">
          <i class="bi bi-calendar-x fs-3"></i>
        </div>
        <div>
          <span class="text-muted small fw-semibold">Donaciones Vencidas</span>
          <h3 class="fw-bold mb-0 text-dark">{{numero resumen.vencidas}}</h3>
          <small class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Descarte / Bajas</small>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card card-donatrack p-3 bg-white border-0 shadow-sm h-100">
      <div class="d-flex align-items-center">
        <div class="rounded-3 bg-success bg-opacity-10 p-3 me-3 text-success">
          <i class="bi bi-people fs-3"></i>
        </div>
        <div>
          <span class="text-muted small fw-semibold">Donantes Registrados</span>
          <h3 class="fw-bold mb-0 text-dark">{{numero resumen.totalDonantes}}</h3>
          <small class="text-success"><i class="bi bi-person-check me-1"></i>Humanos y Jurídicos</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===================== INVENTARIO ===================== -->
<div class="card card-donatrack p-4 bg-white" id="tab-inventario">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-list-ul text-primary me-1"></i>Inventario de Donaciones</h5>
    <span class="text-muted small">
      {{#if paginacion.total}}Mostrando {{paginacion.desde}}–{{paginacion.hasta}} de {{paginacion.total}}{{else}}Sin resultados{{/if}}
    </span>
  </div>

  <!-- Los filtros viajan por GET: la vista queda compartible y el boton atras funciona -->
  <form method="get" action="/admin/deposito" class="row g-2 align-items-end mb-3 pb-3 border-bottom">
    <input type="hidden" name="orden" value="{{ordenActual}}">
    <input type="hidden" name="dir" value="{{dirActual}}">
    <div class="col-sm-6 col-lg-3">
      <label class="form-label small fw-semibold mb-1" for="campo-estado">Estado</label>
      <select id="campo-estado" name="estado" class="form-select form-select-sm">
        <option value="">Todos</option>
        {{#each estados}}
        <option value="{{this}}" {{#if (eq ../filtroEstado this)}}selected{{/if}}>{{estadoTexto this}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-sm-6 col-lg-3">
      <label class="form-label small fw-semibold mb-1" for="campo-categoria">Categoría</label>
      <select id="campo-categoria" name="categoria" class="form-select form-select-sm">
        <option value="">Todas</option>
        {{#each categorias}}
        <option value="{{this}}" {{#if (eq ../filtroCategoria this)}}selected{{/if}}>{{legible this}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-sm-6 col-lg-3">
      <label class="form-label small fw-semibold mb-1" for="campo-donante">Donante</label>
      <select id="campo-donante" name="donante" class="form-select form-select-sm">
        <option value="">Todos</option>
        {{#each donantes}}
        <option value="{{id}}" {{#if (eq ../filtroDonante id)}}selected{{/if}}>{{nombre}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-sm-3 col-lg-1">
      <label class="form-label small fw-semibold mb-1" for="campo-tam">Filas</label>
      <select id="campo-tam" name="tam" class="form-select form-select-sm">
        <option value="10" {{#if (eq tamanio 10)}}selected{{/if}}>10</option>
        <option value="25" {{#if (eq tamanio 25)}}selected{{/if}}>25</option>
        <option value="50" {{#if (eq tamanio 50)}}selected{{/if}}>50</option>
      </select>
    </div>
    <div class="col-sm-9 col-lg-2 d-flex gap-2">
      <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
        <i class="bi bi-funnel me-1"></i>Filtrar
      </button>
      {{#if hayFiltros}}
      <a href="/admin/deposito" class="btn btn-outline-secondary btn-sm" title="Quitar filtros">
        <i class="bi bi-x-lg"></i>
      </a>
      {{/if}}
    </div>
  </form>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th><a href="{{orden.id.href}}" class="text-decoration-none text-dark">ID <i class="bi {{orden.id.icono}}"></i></a></th>
          <th><a href="{{orden.fecha.href}}" class="text-decoration-none text-dark">Fecha <i class="bi {{orden.fecha.icono}}"></i></a></th>
          <th><a href="{{orden.subcategoria.href}}" class="text-decoration-none text-dark">Categoría / Subcategoría <i class="bi {{orden.subcategoria.icono}}"></i></a></th>
          <th><a href="{{orden.cantidad.href}}" class="text-decoration-none text-dark">Cantidad <i class="bi {{orden.cantidad.icono}}"></i></a></th>
          <th>Donante</th>
          <th><a href="{{orden.estado.href}}" class="text-decoration-none text-dark">Estado <i class="bi {{orden.estado.icono}}"></i></a></th>
          <th>Entidad Destino</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each donaciones}}
        <tr>
          <td><strong>#{{id}}</strong></td>
          <td class="text-nowrap small text-muted">{{fecha fechaRegistro}}</td>
          <td>
            <span class="badge bg-secondary me-1">{{legible categoriaNombre}}</span>
            <strong>{{subcategoriaNombre}}</strong>
          </td>
          <td class="text-nowrap">{{cantidad}} {{unidadMedida}}</td>
          <td>{{donanteNombre}}</td>
          <td><span class="estado {{estadoClase estado}}">{{estadoTexto estado}}</span></td>
          <td>{{entidadNombre}}</td>
          <td class="text-end">
            {{#if esEnDeposito}}
            <div class="d-inline-flex gap-1">
              <a href="/admin/matchmaking#donacion-{{id}}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-diagram-3 me-1"></i>Asignar
              </a>
              <form method="post" action="/admin/donaciones/{{id}}/vencer" class="d-inline"
                    data-confirmar="¿Marcar como vencida la donación #{{id}} ({{cantidad}} {{unidadMedida}} de {{subcategoriaNombre}})? Sale del inventario y no se puede deshacer.">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                  <i class="bi bi-calendar-x me-1"></i>Vencida
                </button>
              </form>
            </div>
            {{else}}
            <span class="text-muted small">—</span>
            {{/if}}
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="8" class="text-center text-muted py-4">
            No hay donaciones que cumplan con el filtro.
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{#if paginacion.hayVariasPaginas}}
  <nav class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
    <span class="text-muted small">Página {{paginacion.pagina}} de {{paginacion.totalPaginas}}</span>
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item {{#unless paginacion.hayAnterior}}disabled{{/unless}}">
        <a class="page-link" href="{{paginacion.hrefPrimera}}">«</a>
      </li>
      <li class="page-item {{#unless paginacion.hayAnterior}}disabled{{/unless}}">
        <a class="page-link" href="{{paginacion.hrefAnterior}}">Anterior</a>
      </li>
      <li class="page-item {{#unless paginacion.haySiguiente}}disabled{{/unless}}">
        <a class="page-link" href="{{paginacion.hrefSiguiente}}">Siguiente</a>
      </li>
      <li class="page-item {{#unless paginacion.haySiguiente}}disabled{{/unless}}">
        <a class="page-link" href="{{paginacion.hrefUltima}}">»</a>
      </li>
    </ul>
  </nav>
  {{/if}}
</div>

<!-- ===================== PANEL: NUEVO DONANTE ===================== -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="panelDonante" style="width: 480px;">
  <div id="tab-donante"></div>
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title fw-bold"><i class="bi bi-person-plus text-primary me-1"></i>Registrar Persona Donante</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
  </div>
  <div class="offcanvas-body">
    <p class="small text-muted">Da de alta al donante y le otorga automáticamente su usuario de acceso.</p>
    <form method="post" action="/admin/donantes">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="row g-2">
        <div class="col-5">
          <label class="form-label small fw-semibold" for="adminTipoDonante">Tipo</label>
          <select name="tipo" id="adminTipoDonante" class="form-select form-select-sm" onchange="toggleAdminDonante()">
            <option value="HUMANA">HUMANA</option>
            <option value="JURIDICA">JURIDICA</option>
          </select>
        </div>
        <div class="col-7">
          <label class="form-label small fw-semibold" for="campo-email">Correo Electrónico *</label>
          <input id="campo-email" type="email" name="email" class="form-control form-control-sm" required placeholder="donante@correo.com">
        </div>

        <div class="col-6 adm-hum">
          <label class="form-label small" for="campo-nombre">Nombre *</label>
          <input id="campo-nombre" type="text" name="nombre" class="form-control form-control-sm req-hum" required placeholder="Carlos">
        </div>
        <div class="col-6 adm-hum">
          <label class="form-label small" for="campo-apellido">Apellido *</label>
          <input id="campo-apellido" type="text" name="apellido" class="form-control form-control-sm req-hum" required placeholder="López">
        </div>
        <div class="col-6 adm-hum">
          <label class="form-label small" for="campo-dni">DNI *</label>
          <input id="campo-dni" type="number" name="dni" class="form-control form-control-sm req-hum" required min="1000000" max="99999999" data-error="Ingresá un DNI de 7 u 8 dígitos, sin puntos." placeholder="32000111">
        </div>

        <div class="col-8 adm-jur d-none">
          <label class="form-label small" for="campo-razonSocial">Razón Social *</label>
          <input id="campo-razonSocial" type="text" name="razonSocial" class="form-control form-control-sm req-jur" placeholder="Fundación Sur">
        </div>
        <div class="col-4 adm-jur d-none">
          <label class="form-label small" for="campo-tipoJuridico">Tipo Jurídico</label>
          <select id="campo-tipoJuridico" name="tipoJuridico" class="form-select form-select-sm">
            <option value="EMPRESA">EMPRESA</option>
            <option value="ONG">ONG</option>
            <option value="INSTITUCION">INSTITUCION</option>
            <option value="GUBERNAMENTAL">GUBERNAMENTAL</option>
          </select>
        </div>

        <div class="col-6">
          <label class="form-label small" for="campo-telefono">Teléfono *</label>
          <input id="campo-telefono" type="tel" name="telefono" class="form-control form-control-sm" required pattern="\+?\(?[0-9][0-9 \-\(\)]{5,24}" data-error="Ingresá un teléfono válido: solo números, espacios, guiones o paréntesis. Ej: +54 11 4444-5555." placeholder="+54 11 5555-0000">
        </div>
      </div>
      <button type="submit" class="btn btn-primary w-100 mt-3 fw-semibold">
        <i class="bi bi-person-check me-1"></i>Registrar donante
      </button>
    </form>
  </div>
</div>

<!-- ===================== PANEL: REGISTRAR DONACIÓN ===================== -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="panelDonacion" style="width: 560px;">
  <div id="tab-recepcion"></div>
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title fw-bold"><i class="bi bi-box-arrow-in-down text-success me-1"></i>Registrar Donación Recibida</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
  </div>
  <div class="offcanvas-body">
    <p class="small text-muted">Asociá los bienes recibidos a la persona donante; el sistema segmenta y registra la donación en estado EN_DEPOSITO.</p>
    <form method="post" action="/admin/donaciones">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="row g-2">
        <div class="col-12">
          <label class="form-label small fw-semibold" for="campo-donanteId">Persona Donante *</label>
          <select id="campo-donanteId" name="donanteId" class="form-select form-select-sm" required>
            {{#each donantes}}
            <option value="{{id}}">#{{id}} - {{nombre}} ({{email}})</option>
            {{/each}}
          </select>
        </div>
        <div class="col-12">
          <label class="form-label small fw-semibold" for="campo-descripcionGeneral">Descripción General de la Carga</label>
          <input id="campo-descripcionGeneral" type="text" name="descripcionGeneral" class="form-control form-control-sm" placeholder="Ej: Colecta del club Atlético Medrano" required>
        </div>

        <div class="col-6">
          <label class="form-label small fw-semibold" for="catDonacion">Categoría *</label>
          <!-- Solo acota el combo de abajo: la categoria real la define la
               subcategoria elegida, que es su unica fuente de verdad. -->
          <select id="catDonacion" class="form-select form-select-sm">
            {{#each categorias}}
            <option value="{{this}}">{{legible this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-6">
          <label class="form-label small fw-semibold" for="subDonacion">Subcategoría *</label>
          <select name="subcategoriaId" id="subDonacion" class="form-select form-select-sm" required>
            {{#each subcategorias}}
            <option value="{{id}}" data-categoria="{{categoria}}">{{nombre}}</option>
            {{/each}}
          </select>
          <div class="form-text">
            ¿No está en la lista?
            <a href="#" data-bs-toggle="offcanvas" data-bs-target="#panelSubcategoria">Agregar al catálogo</a>
          </div>
        </div>

        <div class="col-6">
          <label class="form-label small fw-semibold" for="campo-cantidad">Cantidad *</label>
          <input id="campo-cantidad" type="number" name="cantidad" class="form-control form-control-sm" min="1" placeholder="Ej: 25" required>
        </div>
        <div class="col-6">
          <label class="form-label small fw-semibold" for="campo-unidadMedida">Unidad *</label>
          <input id="campo-unidadMedida" type="text" name="unidadMedida" class="form-control form-control-sm" value="unidades" list="unidadesSugeridas" required>
          <!-- Sugerencias para que la misma unidad no se escriba de muchas formas (kg, Kg, kilos...) -->
          <datalist id="unidadesSugeridas">
            <option value="unidades"><option value="kg"><option value="litros"><option value="paquetes"><option value="cajas">
          </datalist>
        </div>

        <div class="col-12">
          <label class="form-label small" for="campo-esNuevo">Estado del bien (Mobiliario / Vestimenta)</label>
          <select id="campo-esNuevo" name="esNuevo" class="form-select form-select-sm">
            <option value="true">Artículo Nuevo</option>
            <option value="false">Artículo Usado en buen estado</option>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label small" for="campo-fechaVencimiento">Fecha de Vencimiento (si es perecedero)</label>
          <input id="campo-fechaVencimiento" type="date" name="fechaVencimiento" class="form-control form-control-sm">
        </div>
      </div>
      <button type="submit" class="btn btn-success w-100 mt-3 fw-semibold">
        <i class="bi bi-plus-circle me-1"></i>Ingresar y segmentar donación
      </button>
    </form>
  </div>
</div>

<!-- ===================== PANEL: NUEVA SUBCATEGORÍA ===================== -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="panelSubcategoria" style="width: 420px;">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title fw-bold"><i class="bi bi-tags text-primary me-1"></i>Nueva Subcategoría</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
  </div>
  <div class="offcanvas-body">
    <p class="small text-muted">
      El catálogo es lo que permite cruzar donaciones con necesidades. Agregá una
      entrada solo si realmente no existe: dos nombres parecidos no se cruzan entre sí.
    </p>
    <form method="post" action="/admin/subcategorias">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <label class="form-label small fw-semibold" for="campo-nombre-2">Nombre *</label>
      <input id="campo-nombre-2" type="text" name="nombre" class="form-control form-control-sm mb-2" required placeholder="Ej: Yerba mate">
      <label class="form-label small fw-semibold" for="campo-categoria-2">Categoría *</label>
      <select id="campo-categoria-2" name="categoria" class="form-select form-select-sm mb-3" required>
        {{#each categorias}}
        <option value="{{this}}">{{legible this}}</option>
        {{/each}}
      </select>
      <button type="submit" class="btn btn-primary w-100 fw-semibold">
        <i class="bi bi-plus-lg me-1"></i>Agregar al catálogo
      </button>
    </form>

    <hr class="my-4">
    <div class="small fw-semibold mb-2">Catálogo actual</div>
    <ul class="list-unstyled small text-muted mb-0">
      {{#each subcategorias}}
      <li><span class="badge bg-secondary me-1">{{categoria}}</span>{{nombre}}</li>
      {{/each}}
    </ul>
  </div>
</div>
{{/partial}}

{{#partial "scripts"}}
<script>
  function toggleAdminDonante() {
    const esJur = document.getElementById('adminTipoDonante').value === 'JURIDICA';
    document.querySelectorAll('.adm-hum').forEach(e => e.classList.toggle('d-none', esJur));
    document.querySelectorAll('.adm-jur').forEach(e => e.classList.toggle('d-none', !esJur));
    // Solo son obligatorios los campos del tipo elegido (los ocultos no se validan)
    document.querySelectorAll('.req-hum').forEach(e => { e.required = !esJur; });
    document.querySelectorAll('.req-jur').forEach(e => { e.required = esJur; });
  }

  // El combo de subcategorias muestra solo las de la categoria elegida.
  // Las opciones se guardan aparte: sacarlas y reponerlas del DOM pierde
  // las que no estan visibles en ese momento.
  (function () {
    var selCategoria = document.getElementById('catDonacion');
    var selSubcategoria = document.getElementById('subDonacion');
    if (!selCategoria || !selSubcategoria) { return; }

    var todas = Array.prototype.slice.call(selSubcategoria.options);

    function filtrar() {
      var categoria = selCategoria.value;
      selSubcategoria.innerHTML = '';
      var visibles = todas.filter(function (o) { return o.dataset.categoria === categoria; });

      if (visibles.length === 0) {
        var vacia = document.createElement('option');
        vacia.value = '';
        vacia.textContent = 'No hay subcategorías para ' + categoria;
        selSubcategoria.appendChild(vacia);
        return;
      }
      visibles.forEach(function (o) { selSubcategoria.appendChild(o); });
    }

    selCategoria.addEventListener('change', filtrar);
    filtrar();

    var params = new URLSearchParams(window.location.search);
    var tabParam = params.get('tab');
    if (tabParam === 'recepcion' || tabParam === 'ingreso') {
      var pDon = document.getElementById('panelDonacion');
      if (pDon && window.bootstrap) { bootstrap.Offcanvas.getOrCreateInstance(pDon).show(); }
    } else if (tabParam === 'donante') {
      var pDte = document.getElementById('panelDonante');
      if (pDte && window.bootstrap) { bootstrap.Offcanvas.getOrCreateInstance(pDte).show(); }
    }
  })();
</script>
{{/partial}}
{{> layout}}
