{{#partial "contenido"}}
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Matchmaking y Selección de Entidad Beneficiaria</h2>
    <p class="text-muted mb-0">Ejecutá los algoritmos de <em>Compatibilidad Semántica</em> y <em>Prioridad a Sub-atendidos</em> y seleccioná la entidad beneficiaria final para cada donación en depósito.</p>
  </div>
  <a href="/admin/deposito" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Volver a Depósito</a>
</div>

<div class="row g-4">
  {{#each donacionesPendientes}}
  <div class="col-12">
    <div class="card card-donatrack p-4 bg-white">
      <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
        <div>
          <span class="badge bg-dark me-1">Donación #{{id}}</span>
          <span class="badge bg-warning text-dark me-1">{{estado}}</span>
          <span class="badge bg-secondary">{{categoriaNombre}}</span>
          <h4 class="fw-bold mt-2 mb-0">{{cantidad}} {{unidadMedida}} de {{subcategoriaNombre}}</h4>
          <small class="text-muted">Donada por: <strong>{{donanteNombre}}</strong> · Fecha: {{fechaRegistro}}</small>
        </div>
        <form method="post" action="/admin/donaciones/{{id}}/matchmaking">
          <button type="submit" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-cpu me-1"></i>Recalcular Algoritmos de Matchmaking
          </button>
        </form>
      </div>

      {{#if esCoincidenciaExacta}}
      <div class="alert alert-success py-2 small">
        <i class="bi bi-stars me-1"></i><strong>Coincidencia entre ambos algoritmos:</strong> Las entidades listadas coinciden tanto en Compatibilidad Semántica como en Prioridad a Sub-atendidos.
      </div>
      {{else}}
      <div class="alert alert-info py-2 small">
        <i class="bi bi-info-circle me-1"></i><strong>Ranking combinado:</strong> Se muestran los resultados propuestos por los algoritmos de evaluación para confirmación manual.
      </div>
      {{/if}}

      <div class="row g-3">
        {{#each sugeridas}}
        <div class="col-md-6 col-lg-4">
          <div class="border rounded-3 p-3 bg-light h-100 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-start">
                <h6 class="fw-bold mb-1">{{razonSocial}}</h6>
                <span class="badge bg-primary">Sugerida</span>
              </div>
              <p class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>{{direccion}}</p>
            </div>
            <form method="post" action="/admin/donaciones/{{../id}}/asignar" class="mt-2">
              <input type="hidden" name="entidadBeneficiariaId" value="{{id}}">
              <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold">
                <i class="bi bi-check2-circle me-1"></i>Confirmar como Destino Final
              </button>
            </form>
          </div>
        </div>
        {{/each}}
      </div>

      <!-- Selección manual alternativa entre todas las entidades -->
      <div class="mt-3 pt-3 border-top">
        <form method="post" action="/admin/donaciones/{{id}}/asignar" class="row g-2 align-items-center">
          <div class="col-auto small fw-semibold text-muted">O seleccionar otra entidad registrada:</div>
          <div class="col-md-5">
            <select name="entidadBeneficiariaId" class="form-select form-select-sm">
              {{#each ../todasEntidades}}
              <option value="{{id}}">{{razonSocial}} ({{direccion}})</option>
              {{/each}}
            </select>
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-outline-success btn-sm">Asignar Entidad</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  {{else}}
  <div class="col-12">
    <div class="alert alert-success">
      <i class="bi bi-check-circle me-1"></i>No hay donaciones pendientes en estado <code>EN_DEPOSITO</code>. Podés ingresar nuevas desde <a href="/admin/deposito">Depósito</a>.
    </div>
  </div>
  {{/each}}
</div>
{{/partial}}
{{> layout}}
