{{#partial "contenido"}}
<div class="row g-4">
  <!-- Formulario de registro de necesidad material (Requerimiento 8 con validación estricta de subcategoría) -->
  <div class="col-lg-5">
    <div class="card card-donatrack p-4 bg-white">
      <h4 class="fw-bold mb-1"><i class="bi bi-clipboard2-plus-fill text-primary me-2"></i>Registrar Necesidad Material</h4>
      <p class="text-muted small mb-3">Declarar necesidades recurrentes (periódicas) o extraordinarias (emergencias) para el algoritmo de matchmaking.</p>

      <form method="post" action="/entidad/necesidades">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="mb-3">
          <label class="form-label fw-semibold">Tipo de Necesidad *</label>
          <select name="tipoNecesidad" id="tipoNecesidad" class="form-select" onchange="togglePeriodo()">
            <option value="EXTRAORDINARIA">Extraordinaria (Emergencia / Situación puntual)</option>
            <option value="RECURRENTE">Recurrente (Funcionamiento habitual por período)</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Categoría *</label>
          <select name="categoria" id="selectCategoria" class="form-select" onchange="filtrarSubcategorias()">
            <option value="ALIMENTOS">ALIMENTOS</option>
            <option value="VESTIMENTA">VESTIMENTA</option>
            <option value="MOBILIARIO">MOBILIARIO</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Subcategoría *</label>
          <select name="subcategoriaNombre" id="selectSubcategoria" class="form-select" required>
            <option value="">-- Seleccioná una subcategoría válida --</option>
            {{#each subcategorias}}
            <option value="{{nombre}}" data-categoria="{{categoria}}">{{nombre}}</option>
            {{/each}}
          </select>
          <div class="form-text small">La subcategoría debe pertenecer obligatoriamente a la categoría seleccionada.</div>
        </div>

        <div class="row g-2 mb-3">
          <div class="col-6">
            <label class="form-label fw-semibold">Cantidad Objetivo *</label>
            <input type="number" name="cantidad" class="form-control" min="1" value="30" required>
          </div>
          <div class="col-6 d-none" id="divPeriodo">
            <label class="form-label fw-semibold">Período de Consumo</label>
            <select name="periodo" class="form-select">
              <option value="SEMANAL">SEMANAL</option>
              <option value="MENSUAL">MENSUAL</option>
              <option value="ANUAL">ANUAL</option>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Breve Descripción *</label>
          <textarea name="descripcion" class="form-control" rows="2" required placeholder="Ej: Reposición de alimentos para el comedor comunitario"></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-100 fw-semibold">
          <i class="bi bi-plus-circle me-1"></i>Guardar Necesidad Material
        </button>
      </form>
    </div>
  </div>

  <!-- Listado de necesidades actuales de la entidad con paginación (Req. 4 y 6) -->
  <div class="col-lg-7">
    <div class="card card-donatrack p-4 bg-white h-100">
      {{#if entidad}}
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h4 class="fw-bold mb-0">{{entidad.razonSocial}}</h4>
          <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>{{entidad.direccion}}</small>
        </div>
        <a href="/entidad/donaciones" class="btn btn-outline-primary btn-sm">Ver Donaciones Asignadas</a>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold text-uppercase text-muted small mb-0">Necesidades Materiales Declaradas</h6>
        <span class="badge bg-light text-dark border">{{entidad.totalNecesidades}} en total ({{entidad.totalPendientes}} pendientes)</span>
      </div>

      <div class="d-flex flex-column gap-3">
        {{#each necesidades}}
        <div class="border rounded-3 p-3 bg-light">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="badge bg-primary me-1">{{tipo}}</span>
              <span class="badge bg-secondary me-1">{{categoriaNombre}}</span>
              <strong>{{subcategoriaNombre}}</strong>
            </div>
            {{#if satisfecha}}
            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Satisfecha</span>
            {{else}}
            <span class="badge bg-warning text-dark">Progreso: {{recibida}} / {{objetivo}} (Faltan: {{faltante}})</span>
            {{/if}}
          </div>
          <div class="progress my-2" style="height: 6px;">
            <div class="progress-bar {{#if satisfecha}}bg-success{{else}}bg-warning{{/if}}" style="width: {{porcentaje}}%;"></div>
          </div>
          <p class="small text-muted mb-1">{{descripcion}}</p>
          <small class="text-muted">Modalidad: {{detallePeriodo}}</small>
        </div>
        {{else}}
        <div class="alert alert-info mb-0">Aún no registraste necesidades materiales.</div>
        {{/each}}
      </div>

      {{#if paginacion.mostrarPaginacion}}
      <nav aria-label="Navegación de necesidades" class="mt-4">
        <div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
          <span>Mostrando necesidades {{paginacion.rangoInicio}} a {{paginacion.rangoFin}} de {{paginacion.totalItems}}</span>
          <span>Página {{paginacion.paginaActual}} de {{paginacion.totalPaginas}}</span>
        </div>
        <ul class="pagination pagination-sm justify-content-center mb-0">
          <li class="page-item {{#unless paginacion.tieneAnterior}}disabled{{/unless}}">
            <a class="page-link" href="{{paginacion.urlAnterior}}">&laquo; Anterior</a>
          </li>
          {{#each paginacion.paginas}}
          <li class="page-item {{#if activa}}active{{/if}}">
            <a class="page-link" href="{{url}}">{{numero}}</a>
          </li>
          {{/each}}
          <li class="page-item {{#unless paginacion.tieneSiguiente}}disabled{{/unless}}">
            <a class="page-link" href="{{paginacion.urlSiguiente}}">Siguiente &raquo;</a>
          </li>
        </ul>
      </nav>
      {{/if}}
      {{/if}}
    </div>
  </div>
</div>
{{/partial}}

{{#partial "scripts"}}
<script>
  function togglePeriodo() {
    const esRecurrente = document.getElementById('tipoNecesidad').value === 'RECURRENTE';
    document.getElementById('divPeriodo').classList.toggle('d-none', !esRecurrente);
  }

  function filtrarSubcategorias() {
    const cat = document.getElementById('selectCategoria').value;
    const subcatSelect = document.getElementById('selectSubcategoria');
    const options = Array.from(subcatSelect.querySelectorAll('option'));
    let firstValid = null;

    options.forEach(opt => {
      if (!opt.value) return; // placeholder
      const optCat = opt.getAttribute('data-categoria');
      if (optCat === cat) {
        opt.hidden = false;
        opt.disabled = false;
        if (!firstValid) firstValid = opt.value;
      } else {
        opt.hidden = true;
        opt.disabled = true;
      }
    });

    const selectedOpt = subcatSelect.options[subcatSelect.selectedIndex];
    if (!selectedOpt || selectedOpt.disabled) {
      subcatSelect.value = firstValid || '';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    filtrarSubcategorias();
    togglePeriodo();
  });
</script>
{{/partial}}
{{> layout}}
