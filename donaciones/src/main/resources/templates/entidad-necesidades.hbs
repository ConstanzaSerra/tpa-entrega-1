{{#partial "contenido"}}
<div class="row g-4">
  <!-- Formulario de registro de necesidad material (Requerimiento 8) -->
  <div class="col-lg-5">
    <div class="card card-donatrack p-4 bg-white">
      <h4 class="fw-bold mb-1"><i class="bi bi-clipboard2-plus-fill text-primary me-2"></i>Registrar Necesidad Material</h4>
      <p class="text-muted small mb-3">Declarar necesidades recurrentes (consumos periódicos) o extraordinarias (emergencias) para el algoritmo de matchmaking.</p>

      <form method="post" action="/entidad/necesidades">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="mb-3">
          <label class="form-label fw-semibold" for="tipoNecesidad">Tipo de Necesidad</label>
          <select name="tipoNecesidad" id="tipoNecesidad" class="form-select" onchange="togglePeriodo()">
            <option value="EXTRAORDINARIA">Extraordinaria (Emergencia / Situación puntual)</option>
            <option value="RECURRENTE">Recurrente (Funcionamiento habitual por período)</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold" for="catNecesidad">Categoría</label>
          <!-- Solo acota el combo de abajo; la categoria real la aporta la
               subcategoria elegida. -->
          <select id="catNecesidad" class="form-select">
            <option value="ALIMENTOS">Alimentos</option>
            <option value="VESTIMENTA">Vestimenta</option>
            <option value="MOBILIARIO">Mobiliario</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold" for="subNecesidad">Subcategoría *</label>
          <!-- Del catalogo y por id: una necesidad de "Arros" no cruzaria
               nunca con una donacion de "Arroz". -->
          <select name="subcategoriaId" id="subNecesidad" class="form-select" required>
            {{#each subcategorias}}
            <option value="{{id}}" data-categoria="{{categoria}}">{{nombre}}</option>
            {{/each}}
          </select>
        </div>

        <div class="row g-2 mb-3">
          <div class="col-6">
            <label class="form-label fw-semibold" for="campo-cantidad">Cantidad Objetivo *</label>
            <input id="campo-cantidad" type="number" name="cantidad" class="form-control" min="1" placeholder="Ej: 30" required>
          </div>
          <div class="col-6 d-none" id="divPeriodo">
            <label class="form-label fw-semibold" for="campo-periodo">Período de Consumo</label>
            <select id="campo-periodo" name="periodo" class="form-select">
              <option value="SEMANAL">Semanal</option>
              <option value="MENSUAL">Mensual</option>
              <option value="ANUAL">Anual</option>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold" for="campo-descripcion">Breve Descripción *</label>
          <textarea id="campo-descripcion" name="descripcion" class="form-control" rows="2" required placeholder="Ej: Reposición de bancos y sillas para el comedor"></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-100 fw-semibold">
          <i class="bi bi-plus-circle me-1"></i>Guardar Necesidad Material
        </button>
      </form>
    </div>
  </div>

  <!-- Listado de necesidades actuales de la entidad -->
  <div class="col-lg-7">
    <div class="card card-donatrack p-4 bg-white h-100">
      {{#if entidad}}
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h4 class="fw-bold mb-0">{{entidad.razonSocial}}</h4>
          <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>{{entidad.direccion}}</small>
        </div>
        <a href="/entidad/donaciones" class="btn btn-outline-primary btn-sm">Ver Donaciones Asignadas</a>
      </div>

      <h6 class="fw-bold text-uppercase text-muted small mb-3">Necesidades Materiales Activas</h6>
      <div class="d-flex flex-column gap-3">
        {{#each entidad.necesidades}}
        <div class="border rounded-3 p-3 bg-light">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="badge bg-primary me-1">{{legible tipo}}</span>
              <span class="badge bg-secondary me-1">{{legible categoriaNombre}}</span>
              <strong>{{subcategoriaNombre}}</strong>
            </div>
            {{#if satisfecha}}
            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Satisfecha</span>
            {{else}}
            <span class="badge bg-warning text-dark">Progreso: {{recibida}} / {{objetivo}}</span>
            {{/if}}
          </div>
          <p class="small text-muted mb-1 mt-2">{{descripcion}}</p>
          <small class="text-muted">Modalidad: {{detallePeriodo}}</small>
        </div>
        {{else}}
        <div class="alert alert-info mb-0">Aún no registraste necesidades materiales.</div>
        {{/each}}
      </div>

      {{#if paginacion.mostrarPaginacion}}
      <nav aria-label="Navegación de páginas" class="mt-4">
        <div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
          <span>Mostrando necesidades {{paginacion.rangoInicio}} a {{paginacion.rangoFin}} de {{paginacion.totalItems}}</span>
          <span>Página {{paginacion.paginaActual}} de {{paginacion.totalPaginas}}</span>
        </div>
        <ul class="pagination pagination-sm justify-content-center mb-0">
          <li class="page-item {{#unless paginacion.tieneAnterior}}disabled{{/unless}}">
            <a class="page-link" href="{{paginacion.urlAnterior}}">&laquo; Anterior</a>
          </li>
          {{#each paginacion.paginas}}
          <li class="page-item {{#if activa}}active{{/if}}">
            <a class="page-link" href="{{url}}">{{numero}}</a>
          </li>
          {{/each}}
          <li class="page-item {{#unless paginacion.tieneSiguiente}}disabled{{/unless}}">
            <a class="page-link" href="{{paginacion.urlSiguiente}}">Siguiente &raquo;</a>
          </li>
        </ul>
      </nav>
      {{/if}}
      {{/if}}
    </div>
  </div>
</div>
{{/partial}}

{{#partial "scripts"}}
<script>
  // El combo de subcategorias muestra solo las de la categoria elegida.
  (function () {
    var selCategoria = document.getElementById('catNecesidad');
    var selSubcategoria = document.getElementById('subNecesidad');
    if (!selCategoria || !selSubcategoria) { return; }

    var todas = Array.prototype.slice.call(selSubcategoria.options);

    function filtrar() {
      var categoria = selCategoria.value;
      selSubcategoria.innerHTML = '';
      var visibles = todas.filter(function (o) { return o.dataset.categoria === categoria; });

      if (visibles.length === 0) {
        var vacia = document.createElement('option');
        vacia.value = '';
        vacia.textContent = 'No hay subcategorías para ' + categoria;
        selSubcategoria.appendChild(vacia);
        return;
      }
      visibles.forEach(function (o) { selSubcategoria.appendChild(o); });
    }

    selCategoria.addEventListener('change', filtrar);
    filtrar();
  })();
</script>
<script>
  function togglePeriodo() {
    const esRecurrente = document.getElementById('tipoNecesidad').value === 'RECURRENTE';
    document.getElementById('divPeriodo').classList.toggle('d-none', !esRecurrente);
  }
</script>
{{/partial}}
{{> layout}}
