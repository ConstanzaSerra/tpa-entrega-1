{{#partial "contenido"}}
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card card-donatrack p-4 p-md-5 bg-white text-center">
      <i class="bi {{#if icono}}{{icono}}{{else}}bi-exclamation-triangle{{/if}} text-warning display-5"></i>
      <h3 class="fw-bold mt-3 mb-2">{{tituloError}}</h3>
      <p class="text-muted mb-4">{{detalleError}}</p>
      <div class="d-flex flex-wrap justify-content-center gap-2">
        <a href="javascript:history.back()" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        <a href="/" class="btn btn-primary"><i class="bi bi-house-door me-1"></i>Ir al inicio</a>
      </div>
    </div>
  </div>
</div>
{{/partial}}
{{> layout}}
