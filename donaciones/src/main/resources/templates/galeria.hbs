{{#partial "contenido"}}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-images text-primary me-2"></i>Galería Pública de Donaciones Entregadas</h2>
    <p class="text-muted mb-0">Evidencia fotográfica cargada por las entidades beneficiarias al confirmar la recepción en sede (acceso libre sin login).</p>
  </div>
  <a href="/mapa-entregas" class="btn btn-primary"><i class="bi bi-geo-alt-fill me-1"></i>Ver en Mapa Interactivo</a>
</div>

<div class="row g-4">
  {{#each entregas}}
  <div class="col-md-6 col-lg-4">
    <div class="card card-donatrack h-100 overflow-hidden">
      <img src="{{fotoPrincipal}}" class="card-img-top" alt="Foto recepción de donación" style="height: 230px; object-fit: cover;">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Recepción Confirmada</span>
          <small class="text-muted">Donación #{{id}}</small>
        </div>
        <h5 class="fw-bold">{{cantidad}} {{unidadMedida}} de {{subcategoriaNombre}}</h5>
        <ul class="list-unstyled small text-muted mb-3">
          <li><i class="bi bi-building-check text-primary me-1"></i><strong>Entidad Beneficiaria:</strong> {{entidadNombre}}</li>
          <li><i class="bi bi-geo-alt text-danger me-1"></i><strong>Dirección:</strong> {{entidadDireccion}}</li>
          <li><i class="bi bi-person-heart text-success me-1"></i><strong>Donante:</strong> {{donanteNombre}}</li>
          <li><i class="bi bi-truck text-secondary me-1"></i><strong>Camión:</strong> {{patenteCamion}} · {{fechaEntrega}}</li>
        </ul>
      </div>
    </div>
  </div>
  {{else}}
  <div class="col-12">
    <div class="alert alert-info">Aún no hay entregas confirmadas con fotos.</div>
  </div>
  {{/each}}
</div>
{{/partial}}
{{> layout}}
