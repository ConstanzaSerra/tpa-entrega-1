<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{tituloPagina}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <style>
    :root {
      --dt-primary: #4f46e5;
      --dt-primary-dark: #3730a3;
      --dt-accent: #0d9488;
      --dt-bg: #f8fafc;
    }
    body {
      background-color: var(--dt-bg);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .navbar-donatrack {
      background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
      box-shadow: 0 2px 12px rgba(0,0,0,0.12);
    }
    .hero-banner {
      background: linear-gradient(135deg, #312e81 0%, #4f46e5 60%, #0d9488 100%);
      color: white;
      border-radius: 1rem;
      padding: 3rem 2.5rem;
      box-shadow: 0 10px 25px rgba(79, 70, 229, 0.2);
    }
    .card-donatrack {
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 0.85rem;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .card-donatrack:hover {
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.09);
    }
    .badge-estado {
      font-weight: 600;
      padding: 0.4em 0.75em;
      border-radius: 999px;
      font-size: 0.78rem;
    }
    .map-container {
      height: 480px;
      width: 100%;
      border-radius: 0.85rem;
      border: 2px solid #e2e8f0;
      z-index: 1;
    }
    footer {
      margin-top: auto;
      background: #0f172a;
      color: #94a3b8;
    }
    footer a {
      color: #cbd5e1;
      text-decoration: none;
    }
    footer a:hover {
      color: #ffffff;
      text-decoration: underline;
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-donatrack sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
      <i class="bi bi-box2-heart-fill text-warning fs-4"></i>
      <span>DonaTrack</span>
      <span class="badge bg-light text-dark fw-normal ms-1" style="font-size: 0.7rem;">UTN Solidaria</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i>Inicio</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/mapa-entregas"><i class="bi bi-geo-alt-fill me-1"></i>Mapa Entregas</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/galeria"><i class="bi bi-images me-1"></i>Fotos Entregas</a>
        </li>

        {{#if esDonante}}
        <li class="nav-item">
          <a class="nav-link text-info fw-semibold" href="/donante/donaciones"><i class="bi bi-gift me-1"></i>Mis Donaciones</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-info fw-semibold" href="/donante/entidades"><i class="bi bi-building-heart me-1"></i>Entidades Beneficiarias</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-info fw-semibold" href="/donante/seguimiento"><i class="bi bi-truck me-1"></i>Seguimiento en Mapa</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/entidad/notificaciones"><i class="bi bi-bell me-1"></i>Notificaciones</a>
        </li>
        {{/if}}

        {{#if esEntidad}}
        <li class="nav-item">
          <a class="nav-link text-warning fw-semibold" href="/entidad/necesidades"><i class="bi bi-clipboard2-plus me-1"></i>Mis Necesidades</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-warning fw-semibold" href="/entidad/donaciones"><i class="bi bi-box-seam me-1"></i>Donaciones Asignadas</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-warning fw-semibold" href="/entidad/seguimiento"><i class="bi bi-truck me-1"></i>Seguimiento en Mapa</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-warning fw-semibold" href="/entidad/notificaciones"><i class="bi bi-bell-fill me-1"></i>Notificaciones</a>
        </li>
        {{/if}}

        {{#if esAdmin}}
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle text-warning fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
            <i class="bi bi-shield-lock-fill me-1"></i>Administración
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/admin/deposito"><i class="bi bi-box-seam me-2"></i>Depósito: Donantes, Cargas y Vencimientos</a></li>
            <li><a class="dropdown-item" href="/admin/matchmaking"><i class="bi bi-diagram-3 me-2"></i>Matchmaking y Asignación de Destino</a></li>
            <li><a class="dropdown-item" href="/admin/camiones"><i class="bi bi-truck-front me-2"></i>Flota de Camiones y Rutas (GraphQL)</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/admin/importar-csv"><i class="bi bi-filetype-csv me-2"></i>Importar Donantes CSV (+10.000 filas)</a></li>
          </ul>
        </li>
        {{/if}}
      </ul>

      <div class="d-flex align-items-center gap-2">
        {{#if usuarioActual}}
          <span class="badge bg-warning text-dark">{{rolUsuario}}</span>
          <span class="text-light small me-2"><i class="bi bi-person-circle me-1"></i>{{nombreUsuario}}</span>
          <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        {{else}}
          <a href="/login" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión</a>
          <a href="/registro" class="btn btn-warning btn-sm fw-semibold text-dark"><i class="bi bi-person-plus-fill me-1"></i>Registrarse</a>
        {{/if}}
      </div>
    </div>
  </div>
</nav>

<main class="container py-4">
  {{#if msg}}
  <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i>{{msg}}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  {{/if}}

  {{#if error}}
  <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>{{error}}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  {{/if}}

  {{#block "contenido"}}{{/block}}
</main>

<footer class="py-4 mt-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6 mb-2 mb-md-0">
        <strong class="text-white"><i class="bi bi-box2-heart-fill text-warning me-1"></i>DonaTrack — UTN Solidaria</strong>
        <p class="small mb-0">Sistema de Gestión y Trazabilidad de Donaciones · Diseño de Sistemas (DDS)</p>
      </div>
      <div class="col-md-6 text-md-end small">
        <a href="/" class="me-3">Inicio</a>
        <a href="/galeria" class="me-3">Fotos de Entregas</a>
        <a href="/mapa-entregas" class="me-3">Mapa Interactivo</a>
        <a href="/registro" class="me-3">Registro</a>
        <a href="/legal">Información Legal y Privacidad</a>
      </div>
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
{{#block "scripts"}}{{/block}}
</body>
</html>
