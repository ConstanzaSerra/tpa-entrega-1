<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{tituloPagina}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <style>
    :root {
      --dt-primary: #4f46e5;
      --dt-primary-dark: #3730a3;
      --dt-accent: #0d9488;
      --dt-bg: #f8fafc;
    }
    body {
      background-color: var(--dt-bg);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      font-size: 1.0625rem;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .navbar-donatrack {
      background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
      box-shadow: 0 2px 12px rgba(0,0,0,0.12);
    }
    .hero-banner {
      background: linear-gradient(135deg, #312e81 0%, #4f46e5 60%, #0d9488 100%);
      color: white;
      border-radius: 1rem;
      padding: 3rem 2.5rem;
      box-shadow: 0 10px 25px rgba(79, 70, 229, 0.2);
    }
    .card-donatrack {
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 0.85rem;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .card-donatrack:hover {
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.09);
    }
    .navbar-donatrack .nav-link.activo {
      color: #ffffff;
      font-weight: 600;
      border-bottom: 2px solid #fbbf24;
    }
    .separador-nav {
      width: 1px;
      height: 1.5rem;
      background-color: rgba(255, 255, 255, 0.25);
      margin: 0 0.75rem;
    }
    .badge-estado {
      font-weight: 600;
      padding: 0.4em 0.75em;
      border-radius: 999px;
      font-size: 0.78rem;
    }
    .map-container {
      height: 480px;
      width: 100%;
      border-radius: 0.85rem;
      border: 2px solid #e2e8f0;
      z-index: 1;
    }
    main {
      flex: 1 0 auto;
    }
    footer {
      margin-top: auto;
      background: #0f172a;
      color: #94a3b8;
    }
    footer a {
      color: #cbd5e1;
      text-decoration: none;
    }
    footer a:hover {
      color: #ffffff;
      text-decoration: underline;
    }

    /* ---------- Paleta unica: el violeta del tema reemplaza al azul por defecto de Bootstrap ---------- */
    :root {
      --bs-primary: #4f46e5;
      --bs-primary-rgb: 79, 70, 229;
      --bs-link-color: #4f46e5;
      --bs-link-color-rgb: 79, 70, 229;
      --bs-link-hover-color: #3730a3;
      --bs-link-hover-color-rgb: 55, 48, 163;
    }
    .btn-primary {
      --bs-btn-bg: #4f46e5; --bs-btn-border-color: #4f46e5;
      --bs-btn-hover-bg: #4338ca; --bs-btn-hover-border-color: #4338ca;
      --bs-btn-active-bg: #3730a3; --bs-btn-active-border-color: #3730a3;
      --bs-btn-disabled-bg: #4f46e5; --bs-btn-disabled-border-color: #4f46e5;
      --bs-btn-focus-shadow-rgb: 79, 70, 229;
    }
    .btn-outline-primary {
      --bs-btn-color: #4f46e5; --bs-btn-border-color: #4f46e5;
      --bs-btn-hover-bg: #4f46e5; --bs-btn-hover-border-color: #4f46e5;
      --bs-btn-active-bg: #4338ca; --bs-btn-active-border-color: #4338ca;
      --bs-btn-disabled-color: #4f46e5; --bs-btn-disabled-border-color: #4f46e5;
      --bs-btn-focus-shadow-rgb: 79, 70, 229;
    }
    .pagination {
      --bs-pagination-color: #4f46e5; --bs-pagination-hover-color: #3730a3; --bs-pagination-focus-color: #3730a3;
      --bs-pagination-active-bg: #4f46e5; --bs-pagination-active-border-color: #4f46e5;
    }
    .nav-pills { --bs-nav-pills-link-active-bg: #4f46e5; }
    .progress { --bs-progress-bar-bg: #4f46e5; }
    .form-check-input:checked { background-color: #4f46e5; border-color: #4f46e5; }
    .form-control:focus, .form-select:focus, .form-check-input:focus {
      border-color: #a5b4fc;
      box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.2);
    }
    .text-indigo { color: #4f46e5 !important; }

    /* ---------- Estados: un color por significado ({{estadoClase estado}}) ---------- */
    .estado {
      display: inline-block;
      font-weight: 600;
      font-size: 0.78rem;
      line-height: 1.2;
      padding: 0.35em 0.75em;
      border-radius: 999px;
      border: 1px solid transparent;
    }
    .estado-deposito  { background: #f1f5f9; color: #334155; border-color: #cbd5e1; }
    .estado-asignada  { background: #e0f2fe; color: #075985; border-color: #bae6fd; }
    .estado-camino    { background: #ede9fe; color: #5b21b6; border-color: #ddd6fe; }
    .estado-entregada { background: #dcfce7; color: #166534; border-color: #bbf7d0; }
    .estado-fallida   { background: #fee2e2; color: #991b1b; border-color: #fecaca; }
    .estado-vencida   { background: #ffedd5; color: #9a3412; border-color: #fed7aa; }
    .estado-otro      { background: #f1f5f9; color: #475569; border-color: #e2e8f0; }

    /* ---------- Encabezado de cada pantalla: en celular el titulo va arriba y los botones abajo ---------- */
    .encabezado-pagina {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 0.75rem 1rem;
    }
    .encabezado-pagina > :first-child { flex: 1 1 24rem; min-width: 0; }
    .encabezado-pagina > :last-child:not(:first-child) { display: flex; flex-wrap: wrap; gap: 0.5rem; }

    /* Textos largos (direcciones, mails, nombres) cortan renglon en vez de salirse de la pantalla.
       break-word (y no anywhere) para no partir numeros cortos como "#44" ni patentes en las tablas. */
    .card-donatrack { overflow-wrap: break-word; }
    .estado, .table .badge { white-space: nowrap; }
    .hero-banner .badge, .badge-contador { white-space: normal; text-align: left; }

    /* Entrega sin foto: se dice, en vez de mostrar una foto de stock */
    .foto-pendiente {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem;
      background: repeating-linear-gradient(45deg, #f1f5f9, #f1f5f9 12px, #e2e8f0 12px, #e2e8f0 24px);
      color: #64748b; font-size: 0.9rem;
    }
    .foto-pendiente i { font-size: 1.75rem; }

    /* ---------- Menu ---------- */
    .navbar-donatrack .nav-link { white-space: nowrap; }
    .navbar-donatrack .usuario-nombre {
      display: inline-block; max-width: 11rem; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; vertical-align: bottom;
    }

    @media (max-width: 575.98px) {
      h2 { font-size: 1.45rem; }
      .hero-banner { padding: 2rem 1.25rem; }
      .map-container { height: 360px; }
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-xl navbar-dark navbar-donatrack sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
      <i class="bi bi-box2-heart-fill text-warning fs-4"></i>
      <span>DonaTrack</span>
      <span class="badge bg-light text-dark fw-normal ms-1" style="font-size: 0.7rem;">UTN Solidaria</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Abrir menú">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto mb-2 mb-xl-0">
        {{#unless usuarioActual}}
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/")}}activo{{/if}}" href="/"><i class="bi bi-house-door me-1"></i>Inicio</a>
        </li>
        {{/unless}}
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/mapa-entregas")}}activo{{/if}}" href="/mapa-entregas"><i class="bi bi-geo-alt-fill me-1"></i>Mapa</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/galeria")}}activo{{/if}}" href="/galeria"><i class="bi bi-images me-1"></i>Fotos</a>
        </li>

        {{#if usuarioActual}}
        <li class="nav-item d-none d-xl-flex align-items-center"><span class="separador-nav"></span></li>
        {{/if}}

        {{#if esDonante}}
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/donante/donaciones")}}activo{{/if}}" href="/donante/donaciones"><i class="bi bi-gift me-1"></i>Mis Donaciones</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/donante/entidades")}}activo{{/if}}" href="/donante/entidades"><i class="bi bi-house-heart me-1"></i>Entidades</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/donante/seguimiento")}}activo{{/if}}" href="/donante/seguimiento"><i class="bi bi-truck me-1"></i>Seguimiento</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/entidad/notificaciones")}}activo{{/if}}" href="/entidad/notificaciones"><i class="bi bi-bell me-1"></i>Notificaciones</a>
        </li>
        {{/if}}

        {{#if esEntidad}}
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/entidad/necesidades")}}activo{{/if}}" href="/entidad/necesidades"><i class="bi bi-clipboard2-plus me-1"></i>Necesidades</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/entidad/donaciones")}}activo{{/if}}" href="/entidad/donaciones"><i class="bi bi-box-seam me-1"></i>Donaciones</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/entidad/seguimiento")}}activo{{/if}}" href="/entidad/seguimiento"><i class="bi bi-truck me-1"></i>Seguimiento</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/entidad/notificaciones")}}activo{{/if}}" href="/entidad/notificaciones"><i class="bi bi-bell-fill me-1"></i>Notificaciones</a>
        </li>
        {{/if}}

        {{#if esAdmin}}
        <!-- Mismo patron que donante y entidad: secciones planas, sin desplegable.
             Importar CSV no esta aca porque es una accion, no una seccion: vive
             dentro de la pantalla de Deposito, que es donde estan los donantes. -->
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/admin/deposito")}}activo{{/if}}" href="/admin/deposito"><i class="bi bi-box-seam me-1"></i>Depósito</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/admin/matchmaking")}}activo{{/if}}" href="/admin/matchmaking"><i class="bi bi-diagram-3 me-1"></i>Matchmaking</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#if (eq rutaActual "/admin/camiones")}}activo{{/if}}" href="/admin/camiones"><i class="bi bi-truck-front me-1"></i>Flota</a>
        </li>
        {{/if}}
      </ul>

      <div class="d-flex align-items-center gap-2">
        {{#if usuarioActual}}
          <div class="dropdown">
            <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle me-1"></i><span class="usuario-nombre">{{nombreUsuario}}</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
              <li><span class="dropdown-item-text small text-muted">
                {{#if esAdmin}}Administración{{/if}}{{#if esDonante}}Persona donante{{/if}}{{#if esEntidad}}Entidad beneficiaria{{/if}}
              </span></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
            </ul>
          </div>
        {{else}}
          <a href="/login" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión</a>
          <a href="/registro" class="btn btn-warning btn-sm fw-semibold text-dark"><i class="bi bi-person-plus-fill me-1"></i>Registrarse</a>
        {{/if}}
      </div>
    </div>
  </div>
</nav>

<main class="container py-4">
  {{#if msg}}
  <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i>{{msg}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
  </div>
  {{/if}}

  {{#if aviso}}
  <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-info-circle-fill me-2"></i>{{aviso}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
  </div>
  {{/if}}

  {{#if error}}
  <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>{{error}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
  </div>
  {{/if}}

  {{#block "contenido"}}{{/block}}
</main>

<footer class="py-4">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6 mb-2 mb-md-0">
        <strong class="text-white"><i class="bi bi-box2-heart-fill text-warning me-1"></i>DonaTrack — UTN Solidaria</strong>
        <p class="small mb-0">Sistema de Gestión y Trazabilidad de Donaciones · Diseño de Sistemas (DDS)</p>
      </div>
      <div class="col-md-6 text-md-end small">
        <a href="/legal">Información Legal y Privacidad</a>
      </div>
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // Acciones que no se pueden deshacer: el formulario declara data-confirmar="mensaje"
  // y se pide confirmacion antes de enviarlo.
  document.addEventListener('submit', function (e) {
    var mensaje = e.target.getAttribute && e.target.getAttribute('data-confirmar');
    if (mensaje && !window.confirm(mensaje)) {
      e.preventDefault();
    }
  });
</script>
{{#block "scripts"}}{{/block}}
</body>
</html>
