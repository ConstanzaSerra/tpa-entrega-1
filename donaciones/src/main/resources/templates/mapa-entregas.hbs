{{#partial "contenido"}}
<div class="encabezado-pagina mb-3">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Mapa Interactivo de Donaciones Entregadas</h2>
    <p class="text-muted mb-0">Hacé clic en cada marcador del mapa para inspeccionar el detalle de los bienes entregados, la entidad beneficiaria y su comprobante fotográfico.</p>
  </div>
  <a href="/galeria" class="btn btn-outline-primary"><i class="bi bi-images me-1"></i>Ver en Galería</a>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div id="mapaPublico" class="map-container shadow-sm"></div>
  </div>
  <div class="col-lg-4">
    <div class="card card-donatrack p-3 h-100">
      <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-list-check me-1"></i>Entregas Registradas en el Mapa</h6>
      <div class="d-flex flex-column gap-3 overflow-auto" style="max-height: 420px;">
        {{#each entregas}}
        <div class="border rounded-3 p-3 bg-light">
          <div class="d-flex justify-content-between">
            <span class="badge bg-success">Donación #{{id}}</span>
            <small class="text-muted">{{fecha fechaEntrega}}</small>
          </div>
          <div class="fw-bold mt-1">{{cantidad}} {{unidadMedida}} de {{subcategoriaNombre}}</div>
          <div class="small text-muted">
            <i class="bi bi-building me-1"></i>{{entidadNombre}}<br>
            <i class="bi bi-geo-alt me-1"></i>{{entidadDireccion}}<br>
            <i class="bi bi-person me-1"></i>Donó: {{donanteNombre}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>
{{/partial}}

{{#partial "scripts"}}
<script>
  const marcadores = {{{marcadoresJson}}};
  const map = L.map('mapaPublico').setView([-34.62, -58.42], 11);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);

  // Los textos vienen de lo que cargan las personas usuarias: se escapan antes de armar el HTML
  // del popup, si no un nombre con <script> se ejecutaria en el navegador de quien mira el mapa (XSS).
  const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const puntos = [];
  marcadores.forEach((m, index) => {
    const lat = m.latitud || (-34.60 - index * 0.02);
    const lon = m.longitud || (-58.41 - index * 0.02);
    const foto = m.fotoPrincipal
      ? `<img src="${esc(m.fotoPrincipal)}" style="width:100%;height:110px;object-fit:cover;border-radius:6px;margin-bottom:6px;" alt="Foto de la entrega"/>`
      : '';
    const popupHtml = `
      <div style="min-width:220px">
        ${foto}
        <div class="estado estado-entregada mb-1">Entregada · #${esc(m.id)}</div>
        <h6 class="fw-bold mb-1">${esc(m.cantidad)} ${esc(m.unidadMedida)} de ${esc(m.subcategoriaNombre)}</h6>
        <div class="small">
          <strong>Entidad:</strong> ${esc(m.entidadNombre)}<br/>
          <strong>Dirección:</strong> ${esc(m.entidadDireccion)}<br/>
          <strong>Donante:</strong> ${esc(m.donanteNombre)}
          ${m.patenteCamion ? `<br/><strong>Camión:</strong> ${esc(m.patenteCamion)}` : ''}
        </div>
      </div>
    `;
    L.marker([lat, lon]).addTo(map).bindPopup(popupHtml);
    puntos.push([lat, lon]);
  });
  // Que todos los marcadores entren en pantalla (antes alguno quedaba cortado en el borde)
  if (puntos.length > 0) {
    map.fitBounds(puntos, { padding: [40, 40], maxZoom: 14 });
  }
</script>
{{/partial}}
{{> layout}}
