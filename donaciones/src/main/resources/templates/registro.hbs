{{#partial "contenido"}}
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card card-donatrack p-4 bg-white">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
          <i class="bi bi-house-heart"></i>
        </div>
        <div>
          <h2 class="fw-bold mb-1">Registro de Entidad Beneficiaria</h2>
          <p class="text-muted mb-0">Creá la cuenta de tu organización (comedor, escuela, merendero, hogar) para declarar necesidades y recibir donaciones con trazabilidad.</p>
        </div>
      </div>

      <div class="alert alert-light border small mb-4">
        <i class="bi bi-info-circle-fill text-primary me-2"></i>
        <strong>¿Sos una persona donante?</strong> Las personas donantes son registradas presencialmente en el depósito de recepción o mediante la carga del padrón oficial por el equipo administrador. Si ya estás registrado/a, <a href="/login" class="fw-semibold">iniciá sesión acá</a>.
      </div>

      <p class="small text-muted mb-3">Los campos marcados con * son obligatorios.</p>
      <form method="post" action="/registro/entidad">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold" for="campo-razonSocial">Razón social *</label>
            <input id="campo-razonSocial" type="text" name="razonSocial" class="form-control{{#if errores.razonSocial}} is-invalid{{/if}}" value="{{valores.razonSocial}}" required autocomplete="organization" placeholder="Ej: Comedor Comunitario Esperanza">
            {{#if errores.razonSocial}}<div class="invalid-feedback">{{errores.razonSocial}}</div>{{/if}}
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold" for="campo-direccion">Dirección de la sede *</label>
            <input id="campo-direccion" type="text" name="direccion" class="form-control{{#if errores.direccion}} is-invalid{{/if}}" value="{{valores.direccion}}" required autocomplete="street-address" placeholder="Ej: Av. Rivadavia 4500, CABA">
            {{#if errores.direccion}}<div class="invalid-feedback">{{errores.direccion}}</div>{{/if}}
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold" for="campo-telefono">Teléfono *</label>
            <input id="campo-telefono" type="tel" name="telefono" class="form-control{{#if errores.telefono}} is-invalid{{/if}}" value="{{valores.telefono}}" required autocomplete="tel" pattern="\+?\(?[0-9][0-9 \-\(\)]{5,24}" data-error="Ingresá un teléfono válido: solo números, espacios, guiones o paréntesis. Ej: +54 11 4444-5555." placeholder="+54 11 4444-5555">
            {{#if errores.telefono}}<div class="invalid-feedback">{{errores.telefono}}</div>{{/if}}
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold" for="campo-email">Correo *</label>
            <input id="campo-email" type="email" name="email" class="form-control{{#if errores.email}} is-invalid{{/if}}" value="{{valores.email}}" required autocomplete="email" placeholder="contacto@entidad.org">
            {{#if errores.email}}<div class="invalid-feedback">{{errores.email}}</div>{{/if}}
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold" for="campo-password">Contraseña (mínimo 6) *</label>
            <input id="campo-password" type="password" name="password" class="form-control{{#if errores.password}} is-invalid{{/if}}" required autocomplete="new-password" minlength="6" placeholder="Mínimo 6 caracteres">
            {{#if errores.password}}<div class="invalid-feedback">{{errores.password}}</div>{{/if}}
          </div>
        </div>

        <div class="mt-4 d-flex justify-content-between align-items-center">
          <a href="/login" class="text-decoration-none small">¿Ya tenés cuenta? Iniciá sesión</a>
          <button type="submit" class="btn btn-success px-4 fw-semibold">
            <i class="bi bi-building-add me-1"></i>Registrar Entidad Beneficiaria
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{{/partial}}
{{> layout}}
