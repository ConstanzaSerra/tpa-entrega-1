{{#partial "contenido"}}
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card card-donatrack p-4 bg-white">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
          <i class="bi bi-building-heart"></i>
        </div>
        <div>
          <h2 class="fw-bold mb-1">Registro de Entidad Beneficiaria</h2>
          <p class="text-muted mb-0">Creá la cuenta de tu organización (comedor, escuela, merendero, hogar) para declarar necesidades y recibir donaciones con trazabilidad.</p>
        </div>
      </div>

      <div class="alert alert-light border small mb-4">
        <i class="bi bi-info-circle-fill text-primary me-2"></i>
        <strong>¿Sos una persona donante?</strong> Las personas donantes son registradas presencialmente en el depósito de recepción o mediante la carga del padrón oficial por el equipo administrador. Si ya estás registrado/a, <a href="/login" class="fw-semibold">iniciá sesión acá</a>.
      </div>

      <form method="post" action="/registro/entidad">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Razón Social de la Entidad *</label>
            <input type="text" name="razonSocial" class="form-control" required placeholder="Ej: Comedor Comunitario Esperanza">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Dirección Completa (Sede de recepción) *</label>
            <input type="text" name="direccion" class="form-control" required placeholder="Ej: Av. Rivadavia 4500, CABA">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Teléfono de Contacto *</label>
            <input type="text" name="telefono" class="form-control" required placeholder="+54 11 4444-5555">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Correo del Representante *</label>
            <input type="email" name="email" class="form-control" required placeholder="contacto@entidad.org">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Contraseña de acceso *</label>
            <input type="password" name="password" class="form-control" required placeholder="Mínimo 6 caracteres">
          </div>
        </div>

        <div class="mt-4 d-flex justify-content-between align-items-center">
          <a href="/login" class="text-decoration-none small">¿Ya tenés cuenta? Iniciá sesión</a>
          <button type="submit" class="btn btn-success px-4 fw-semibold">
            <i class="bi bi-building-add me-1"></i>Registrar Entidad Beneficiaria
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{{/partial}}
{{> layout}}
