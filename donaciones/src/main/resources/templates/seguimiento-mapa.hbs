{{#partial "contenido"}}
<div class="encabezado-pagina mb-3">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-truck text-primary me-2"></i>Seguimiento de entregas en camino</h2>
    <p class="text-muted mb-0">Ubicación del camión que lleva cada donación y cuándo se actualizó por última vez. La página se actualiza sola cada 30 segundos.</p>
  </div>
  <div>
    <span class="small text-muted" id="proximaActualizacion" aria-live="polite"></span>
    <button class="btn btn-outline-primary btn-sm" onclick="window.location.reload()">
      <i class="bi bi-arrow-clockwise me-1"></i>Actualizar ahora
    </button>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div id="mapaSeguimiento" class="map-container shadow-sm"></div>
  </div>
  <div class="col-lg-4">
    <div class="card card-donatrack p-3 bg-white h-100">
      <h6 class="fw-bold text-uppercase text-muted small mb-3">
        <i class="bi bi-broadcast-pin text-danger me-1"></i>Entregas en camino
      </h6>
      <div class="d-flex flex-column gap-3">
        {{#each entregasActivas}}
        <div class="border rounded-3 p-3 bg-light">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="estado {{estadoClase estado}}">{{estadoTexto estado}}</span>
            <span class="badge bg-dark"><i class="bi bi-truck me-1"></i>Camión {{patenteCamion}}</span>
          </div>
          <h6 class="fw-bold mb-1">Donación #{{id}}: {{cantidad}} {{unidadMedida}} de {{subcategoriaNombre}}</h6>
          <div class="small text-muted">
            <i class="bi bi-building me-1"></i><strong>Destino:</strong> {{entidadNombre}}<br>
            <i class="bi bi-geo-alt me-1"></i>{{entidadDireccion}}<br>
            <i class="bi bi-speedometer2 me-1"></i><strong>Velocidad:</strong> {{numero velocidadCamion}} km/h<br>
            <i class="bi bi-clock me-1"></i><strong>Posición actualizada:</strong> {{fecha ultimaActualizacion}}
          </div>
          <div class="progress mt-2" style="height: 8px;" role="progressbar" aria-label="Avance del recorrido"
               aria-valuenow="{{avancePorcentaje}}" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: {{avancePorcentaje}}%"></div>
          </div>
          <div class="small text-muted mt-1">{{avancePorcentaje}}% del recorrido</div>
        </div>
        {{else}}
        <div class="alert alert-secondary small mb-0">No hay entregas en camino en este momento.</div>
        {{/each}}
      </div>
    </div>
  </div>
</div>
{{/partial}}

{{#partial "scripts"}}
<script>
  const activas = {{{entregasActivasJson}}};
  const map = L.map('mapaSeguimiento').setView([-34.605, -58.425], 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);

  const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const puntos = [];
  activas.forEach((e, idx) => {
    const latCamion = e.latitudCamion || -34.5986;
    const lonCamion = e.longitudCamion || -58.4199;
    const latDest = e.latitudDestino || -34.62;
    const lonDest = e.longitudDestino || -58.44;

    const popupCamion = `
      <div>
        <span class="badge bg-dark mb-1">Camión ${esc(e.patenteCamion)}</span>
        <h6 class="fw-bold mb-1">Donación #${esc(e.id)} (${esc(e.subcategoriaNombre)})</h6>
        <div class="small">
          <strong>Hacia:</strong> ${esc(e.entidadNombre)}<br/>
          <strong>Velocidad:</strong> ${esc(Math.round(e.velocidadCamion || 0))} km/h
        </div>
      </div>
    `;
    L.marker([latCamion, lonCamion]).addTo(map).bindPopup(popupCamion);
    L.circleMarker([latDest, lonDest], { radius: 8, color: '#16a34a' })
      .addTo(map)
      .bindPopup(`<strong>Destino:</strong> ${esc(e.entidadNombre)}<br/>${esc(e.entidadDireccion)}`);
    L.polyline([[latCamion, lonCamion], [latDest, lonDest]], { color: '#4f46e5', dashArray: '6, 6' }).addTo(map);
    puntos.push([latCamion, lonCamion], [latDest, lonDest]);
  });
  if (puntos.length > 0) {
    map.fitBounds(puntos, { padding: [40, 40], maxZoom: 14 });
  }

  // Actualizacion automatica: la posicion la reporta el GPS del camion; se recarga la vista
  // cada 30 segundos (solo si hay entregas en camino y la pestana esta visible).
  if (activas.length > 0) {
    let segundos = 30;
    const aviso = document.getElementById('proximaActualizacion');
    setInterval(() => {
      if (document.hidden) return;
      segundos -= 1;
      if (segundos <= 0) { window.location.reload(); return; }
      if (aviso) aviso.textContent = `Se actualiza en ${segundos} s · `;
    }, 1000);
  }
</script>
{{/partial}}
{{> layout}}
